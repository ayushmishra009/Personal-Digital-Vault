# Copy to .env only for manual setup. `pnpm dev:services:up` creates a
# local .env with randomly generated development credentials if absent.
APP_ENV=development
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://pdv_dev:replace-me@127.0.0.1:5432/pdv?sslmode=disable
POSTGRES_USER=pdv_dev
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=pdv
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=pdv_local
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=pdv-encrypted-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
API_ORIGIN=http://localhost:8080
LOG_LEVEL=info
