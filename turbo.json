{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "GOCACHE",
    "GOMODCACHE",
    "GOTELEMETRY",
    "DATABASE_URL",
    "APP_ENV",
    "API_ADDR",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "S3_REGION",
    "S3_FORCE_PATH_STYLE",
    "WEB_ORIGIN",
    "ADMIN_ORIGIN",
    "API_ORIGIN",
    "LOG_LEVEL"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "bin/**", ".output/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^test"], "outputs": ["coverage/**"] }
  }
}
